# Copy this file to .env and fill in your own values. Never commit .env.

# --- LLM provider (any OpenAI-compatible endpoint) ---
# Default: Google Gemini API free tier (create a free key at https://aistudio.google.com/apikey)
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite

# Alternative: local model with Ollama (no key needed, any non-empty value works)
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=<local-model-with-tool-support>

# --- Business context ---
# Date treated as "today" for date-based rules (the data is a snapshot ending in March 2026)
REFERENCE_DATE=2026-03-25
